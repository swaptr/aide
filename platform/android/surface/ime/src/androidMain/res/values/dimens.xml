<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- KeyPopup geometry. Consumed by KeyPopupView's paint setup. -->
    <dimen name="aide_popup_cell_width">48dp</dimen>
    <dimen name="aide_popup_cell_height">44dp</dimen>
    <dimen name="aide_popup_corner_radius">20dp</dimen>
    <dimen name="aide_popup_text_size">20sp</dimen>

    <!--
        AideButton-exclusive geometry. Every other IME widget reads from
        `com.sabreware.aide.platform.android.surface.ime.theme.*` (Spacing, Sizes, Shapes, Typography,
        Motion, Elevation). These three remain in XML because AideButton.kt is
        intentionally untouched and still reads them via getDimensionPixelSize.
    -->
    <dimen name="ime_gap">3dp</dimen>
    <dimen name="ime_button_size">42dp</dimen>
    <dimen name="ime_icon_size">24dp</dimen>
</resources>
