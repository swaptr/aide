    <color name="aide_secondary_container">#FFDCDCDC</color>
    <color name="aide_on_secondary_container">#FF1A1A1A</color>
    <color name="aide_apply">#FF2BB673</color>
    <color name="aide_icon_button_disabled_bg">#1FFFFFFF</color>
    <color name="aide_icon_button_disabled_icon">#61FFFFFF</color>
