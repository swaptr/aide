        Aide brand palette — single source of truth for both the IME (read by
        Theme.Aide.Ime in themes.xml) and the in-app Compose theme (read via
        colorResource in ui/theme/Theme.kt). DayNight variants in
        values-night/colors.xml.
    -->
    <color name="aide_accent">#FF3DA639</color>
    <color name="aide_on_primary">#FFFFFFFF</color>
    <color name="aide_surface">#FFF5F5F5</color>
    <color name="aide_surface_container">#FFFFFFFF</color>
    <color name="aide_surface_container_high">#FFEDEDED</color>
    <color name="aide_on_surface">#FF1A1A1A</color>
    <color name="aide_on_surface_variant">#FF555555</color>
    <color name="aide_outline">#FFBDBDBD</color>
    <color name="aide_outline_variant">#FFD9D9D9</color>
